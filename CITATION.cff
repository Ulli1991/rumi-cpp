# When built with ENABLE_MSTAR (optional GPLv3 module src/mstar: the KETJU/MSTAR integrator and its Kokkos port),
# also cite the two MSTAR/KETJU papers below (src/mstar/README.md).
references:
  - type: article
    authors:
      - family-names: Rantala
        given-names: Antti
      - family-names: Pihajoki
        given-names: Pauli
      - family-names: Mannerkoski
        given-names: Matias
      - family-names: Johansson
        given-names: Peter H.
      - family-names: Naab
        given-names: Thorsten
    title: "MSTAR - a fast parallelised algorithmically regularised integrator with minimum spanning tree coordinates"
    journal: "Monthly Notices of the Royal Astronomical Society"
    volume: 492
    start: 4131
    year: 2020
    identifiers:
      - type: other
        value: "arXiv:2001.03180"
    notes: "When built with ENABLE_MSTAR (required citation of the KETJU integrator)."
  - type: article
    authors:
      - family-names: Mannerkoski
        given-names: Matias
    title: "KETJU - resolving small-scale supermassive black hole dynamics in GADGET-4"
    journal: "Monthly Notices of the Royal Astronomical Society"
    volume: 524
    start: 4062
    year: 2023
    identifiers:
      - type: other
        value: "arXiv:2306.04963"
    notes: "When built with ENABLE_MSTAR (released KETJU integrator: PN, BH mergers and recoil, order control); et al."
