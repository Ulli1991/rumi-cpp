cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "RUMI++: a collisional N-body code"
type: software
authors:
  - family-names: Steinwandel
    given-names: Ulrich
    orcid: "https://orcid.org/0000-0001-8867-5026"
